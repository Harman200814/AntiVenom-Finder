# Copy to .env and fill in values. Never commit real .env to public GitHub.

ADMIN_USERNAME=Codecrasher
# Prefer setting a strong password here; the server hashes it with bcrypt at startup.
ADMIN_PASSWORD=your-strong-password-here

# Optional: store only a bcrypt hash instead of the plain password
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
# ADMIN_PASSWORD_HASH=$2a$12$...

# SESSION_SECRET=long-random-string-for-cookie-signing
# PORT=3000
